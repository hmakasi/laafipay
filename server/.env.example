DATABASE_URL="postgresql://laafipay:changeme@localhost:5433/laafipay?schema=public"
DIRECT_URL="postgresql://laafipay:changeme@localhost:5433/laafipay?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Passerelle LaafiPay -> LaafiCompta (POST /api/compta/payroll-events) —
# la livraison se fait maintenant en appel de fonction direct (voir
# comptaBridge.ts), cette clé ne protège plus que la route HTTP elle-même
# pour le jour où LaafiCompta devient un service externe.
LAAFICOMPTA_API_KEY="change-me-in-production"

# Cron de retry de la passerelle Paie -> Compta (GET /api/compta/retry-bridge,
# voir vercel.json "crons") — Vercel envoie automatiquement
# "Authorization: Bearer $CRON_SECRET" aux requêtes cron quand cette
# variable est configurée sur le projet.
CRON_SECRET="change-me-in-production"

# Envoi des bulletins de paie par WhatsApp (Meta Cloud API).
WHATSAPP_PHONE_NUMBER_ID="change-me"
WHATSAPP_ACCESS_TOKEN="change-me"
WHATSAPP_TEMPLATE_NAME="bulletin_disponible"
WHATSAPP_TEMPLATE_LANG="fr"

# Équipe LaafiPay autorisée à approuver/rejeter les demandes de création
# d'entreprise (GET/POST /api/admin/signup-requests/...) — e-mails séparés
# par des virgules.
PLATFORM_ADMIN_EMAILS="change-me"

# Amorçage du tout premier admin LaafiPay (POST /api/admin/bootstrap) —
# voir le commentaire dans admin.routes.ts. À utiliser une fois puis à
# laisser en place (protégé par ce secret + PLATFORM_ADMIN_EMAILS).
BOOTSTRAP_SECRET="change-me"

# Envoi des identifiants générés à l'approbation d'une demande de création
# d'entreprise (server/src/lib/email.ts, via Resend).
RESEND_API_KEY="change-me"
RESEND_FROM_EMAIL="change-me"

# Webhook entrant WhatsApp (Meta Cloud API) — POST /api/whatsapp/webhook.
WHATSAPP_APP_SECRET="<app secret from Meta Business Manager>"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="<a random string you choose, entered identically in Meta's webhook config>"
WHATSAPP_LEAVE_MANAGER_TEMPLATE_NAME="demande_conge_manager"
WHATSAPP_LEAVE_APPROVED_TEMPLATE_NAME="conge_valide"
WHATSAPP_LEAVE_REFUSED_TEMPLATE_NAME="conge_refuse"
